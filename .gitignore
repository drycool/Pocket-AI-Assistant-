# Конфигурации и ключи
Data/config.json
Data/config.public.json
Data/config.fast.json

# FastAgent: сессии, снимки и журнал действий
Data/sessions-fast/*.json
Data/sessions-fast/*.tmp
Data/logs/fast-sysinfo_*.txt
Data/logs/actions_*.log
Data/logs/field-*.txt
Data/reports/REPORT_FAST_*.md

# Данные сессий и дампы систем
Data/sessions/*.json
Data/logs/*.txt
Data/reports/*.md

# Кеш и загрузки браузера
Data/downloads/*
Data/firefox/cache/*

# Исполняемые файлы и артефакты Python
*.exe
FastAgent/fastagent
*.pyc
__pycache__/

# Резервные копии файлов (ручные .bak-YYYYMMDD / .bak)
*.bak
*.bak-*


# Архивы полевых прогонов (машинные данные гостевых ПК — не публикуем)
Data/logs/field-run-*/
